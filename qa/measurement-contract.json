  "resultSchema": {
    "measurements": [
      "inputTokens",
      "outputTokens",
      "cacheReadTokens",
      "cacheWriteTokens",
      "wallTimeMs",
      "contextBytes",
      "exitStatus"
    ],
    "availabilityEncoding": {
      "available": "available",
      "unavailable": "unavailable"
    },
    "unavailableReasons": [
      "provider_not_reported",
      "not_applicable",
      "process_terminated",
      "measurement_failed",
      "grader_failed_before_measurement"
    ],
    "recordRule": "Every measurement is an object with status=available and a finite numeric value, or status=unavailable and one declared reason. Null, omission, and implicit zero are invalid.",
    "graderVerdict": {
      "available": {
        "status": "available",
        "passed": "boolean",
        "score": "finite number"
      },
      "unavailable": {
        "status": "unavailable",
        "reason": "declared unavailable reason"
      },
      "rule": "A completed valid attempt records the hidden grader pass verdict and score. A process or grading failure records an explicit unavailable reason."
    }
  },
  "failureTaxonomy": [
    {
      "id": "success",
      "definition": "The process exited zero, output parsed, and the hidden grader returned a valid passing or failing score.",
      "inDenominator": true
    },
    {
      "id": "timeout",
      "definition": "The per-attempt wall-time limit elapsed before process completion.",
      "inDenominator": true
    },
    {
      "id": "crash",
      "definition": "The process exited non-zero, received a signal, failed to start, or terminated without a more specific declared classification.",
      "inDenominator": true
    },
    {
      "id": "refusal",
      "definition": "The output explicitly declined the requested task and the refusal classifier produced a valid verdict.",
      "inDenominator": true
    },
    {
      "id": "invalid_output",
      "definition": "The process completed but its output was missing, malformed, duplicated, or failed the declared output schema.",
      "inDenominator": true
    },
    {
      "id": "grader_failure",
      "definition": "The hidden grader crashed, timed out, returned malformed output, or could not produce a verdict.",
      "inDenominator": true
    }
  ],
  "accounting": {
    "denominator": "all_attempted_records",
    "appendBeforeExecution": true,
    "dropFailures": false,
    "maxAttemptsPerSystemCase": 1,
    "attemptIdentity": [
      "runId",
      "systemId",
      "caseId",
      "attemptNumber"
    ],
    "rule": "Persist the attempt identity and start timestamp before spawning Pi. Finalize that same record for every outcome. Aggregation must reject missing or duplicate scheduled pairs; filters may not alter failure denominators."
  },
  "stopRules": {
    "perAttemptTimeoutMs": 120000,
    "terminationGraceMs": 5000,
    "retainCurrentAttempt": true,
    "listEveryUnattemptedPair": true,
    "allowedRunStopReasons": [
      "contract_invalid",
      "fixture_checksum_mismatch",
      "grader_checksum_mismatch",
      "insufficient_disk",
      "operator_interrupt"
    ],
    "minimumFreeDiskBytes": 1073741824,
    "rule": "No automatic retry is permitted. A run-level stop finalizes any started attempt, records the stop reason, and enumerates every scheduled but unattempted system/case pair."
  },
  "statistics": {
    "referenceSystemId": "bare_pi_0_85_1",
    "pairingKey": "caseId",
    "failureOutcomeDenominator": "all_attempted_pairs",
    "unavailableMetricPolicy": "no_imputation_report_counts",
    "outcome": {
      "measure": "hidden grader passed; every non-success attempt contributes false",
      "summaries": [
        "paired_success_delta",
        "discordant_pair_counts",
        "exact_two_sided_mcnemar_p"
      ]
    },
    "continuousMeasurements": [
      "inputTokens",
      "outputTokens",
      "cacheReadTokens",
      "cacheWriteTokens",
      "wallTimeMs",
      "contextBytes"
    ],
    "continuousSummaries": [
      "paired_count",
      "unavailable_count_by_reason",
      "median_paired_delta",
      "median_absolute_deviation",
      "p05_paired_delta",
      "p95_paired_delta"
    ],
    "eligibilityRule": "Outcome statistics include every attempted reference/candidate pair. Continuous statistics use only pairs where both values are available; excluded counts and reasons are reported and values are never imputed."
  },
  "perRunIdentitySchema": {
    "requiredFields": [
      "contractSha256",
      "caseCorpusSha256",
      "graderSha256",
      "systemId",
      "packageArtifactChecksums",
      "installedRuntimeExecutableSha256",
      "providerContractSha256",
      "nodeVersion",
      "npmVersion",
      "piVersion",
      "bunVersion",
      "osPlatform",
      "osRelease",
      "osArchitecture",
      "osVersion",
      "osBuild",
      "configuration",
      "exactCommand"
    ],
    "rule": "Capture observed values before the first attempt. A missing installed runtime or provider field is an invalid run, not an unavailable usage measurement."
  },
  "failureClassificationPrecedence": [
    "timeout",
    "crash",
    "invalid_output",
    "grader_failure",
    "refusal",
    "success"
  ]
}
